<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuickPlaces.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickPlaces.Models"
    Background="Transparent">

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="Back to results"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Quick Places"
                TextTrimming="CharacterEllipsis" />
            <ProgressRing
                x:Name="LoadingRing"
                Grid.Column="2"
                Width="16"
                Height="16"
                Margin="0,0,4,0"
                IsActive="False" />
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <!--  Missing key  -->
        <TextBlock
            x:Name="MissingKeyText"
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Add GooglePlacesApiKey to OAuth.resw and rebuild."
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!--  Search  -->
        <Grid
            x:Name="SearchPanel"
            Grid.Row="2"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    AutomationProperties.Name="Search nearby"
                    KeyDown="SearchBox_KeyDown"
                    PlaceholderText="Search nearby: pizza, pharmacy, plumber" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Search"
                    Click="SearchButton_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE721;" />
                </Button>
            </Grid>
            <ListView
                x:Name="ResultsList"
                Grid.Row="1"
                IsItemClickEnabled="True"
                ItemClick="ResultsList_ItemClick"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaceSummary">
                        <Grid Padding="0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Address}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind DistanceText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="EmptyText"
                Grid.Row="1"
                Margin="4,8,0,0"
                VerticalAlignment="Top"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Type what you're looking for and press Enter."
                TextWrapping="Wrap" />
        </Grid>

        <!--  Details  -->
        <ScrollViewer
            x:Name="DetailPanel"
            Grid.Row="2"
            Padding="0,0,12,0"
            Visibility="Collapsed">
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="AddressText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="OpenNowText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Visibility="Collapsed" />
                </StackPanel>

                <!--  Phone + QR  -->
                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="PhoneText"
                            Style="{StaticResource TitleTextBlockStyle}"
                            IsTextSelectionEnabled="True" />
                        <StackPanel
                            x:Name="QrPanel"
                            HorizontalAlignment="Center"
                            Spacing="6">
                            <Border
                                Width="168"
                                Height="168"
                                Background="White"
                                CornerRadius="4">
                                <Image
                                    x:Name="QrImage"
                                    AutomationProperties.Name="QR code to call this number from your phone"
                                    Stretch="Uniform" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Scan with your phone's camera to call" />
                        </StackPanel>
                        <Button
                            x:Name="CopyPhoneButton"
                            HorizontalAlignment="Stretch"
                            Click="CopyPhoneButton_Click"
                            Content="Copy number" />
                    </StackPanel>
                </Border>

                <!--  Links  -->
                <StackPanel Spacing="4">
                    <HyperlinkButton
                        x:Name="WebsiteLink"
                        Padding="0"
                        Click="WebsiteLink_Click" />
                    <HyperlinkButton
                        x:Name="MapsLink"
                        Padding="0"
                        Click="MapsLink_Click"
                        Content="Open in Google Maps" />
                </StackPanel>

                <!--  Hours  -->
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Hours" />
                    <StackPanel x:Name="HoursPanel" Spacing="2" />
                    <TextBlock
                        x:Name="NoHoursText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No hours listed."
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
